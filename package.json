{
  "name": "gds-erp-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx --conditions=react-server scripts/check-database.ts",
    "db:init:project-foundation": "tsx --conditions=react-server scripts/initialize-project-foundation.ts",
    "db:init:design-users": "tsx --conditions=react-server scripts/initialize-design-users.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "latest",
    "postgres": "^3.4.9",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
